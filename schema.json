{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "Cypress Spec Runner project configuration",
    "type": "object",
    "additionalProperties": false,
    "required": ["version", "name", "configFile", "envFile", "profiles", "defaultProfile"],
    "properties": {
        "$schema": { "type": "string" },
        "version": { "const": 1 },
        "name": { "type": "string", "minLength": 1, "maxLength": 100 },
        "configFile": { "type": ["string", "null"], "description": "Project-relative Cypress configuration path." },
        "specPattern": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "excludeSpecPattern": { "type": "array", "items": { "type": "string" } },
        "envFile": { "type": ["string", "null"], "description": "Local environment file, excluded from Git." },
        "browsers": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["chrome", "electron", "edge", "firefox"] }, "description": "Browsers available in this project. Omit to allow all supported browsers." },
        "defaultProfile": { "type": "string" },
        "maxConcurrentRuns": {"type": "integer", "minimum": 1, "maximum": 8, "default": 2, "description": "Maximum runs executing simultaneously in this app instance."},
        "concurrencyGroups": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["id", "name", "maxConcurrentRuns"], "properties": {"id": {"type": "string", "pattern": "^[a-zA-Z0-9_-]{1,100}$"}, "name": {"type": "string", "minLength": 1, "maxLength": 100}, "maxConcurrentRuns": {"type": "integer", "minimum": 1, "maximum": 8}}}},
        "profiles": {
            "type": "array", "minItems": 1,
            "items": {
                "type": "object", "additionalProperties": false,
                "required": ["id", "name", "args", "env"],
                "properties": {
                    "id": { "type": "string", "pattern": "^[a-zA-Z0-9_-]{1,100}$" },
                    "name": { "type": "string", "minLength": 1, "maxLength": 100 },
                    "baseUrl": { "type": "string" },
                    "args": { "type": "array", "items": { "type": "string" } },
                    "maxConcurrentRuns": {"type": "integer", "minimum": 1, "maximum": 8, "default": 1},
                    "concurrencyGroup": {"type": "string", "description": "ID of a configured shared concurrency group."},
                    "env": { "type": "object", "propertyNames": { "pattern": "^[a-zA-Z_][a-zA-Z0-9_]*$" }, "additionalProperties": { "type": "string" } }
                }
            }
        }
    }
}
